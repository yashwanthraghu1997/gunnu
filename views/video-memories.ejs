<%- include('partials/header') %>

<!-- Dedicated Video Memories Stylesheet -->
<link rel="stylesheet" href="/css/video-memories.css">

<!-- Google Fonts: Handwritten Font for Memory Story -->
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&display=swap" rel="stylesheet">

<body class="video-memories-page">

  <!-- Top Header Navigation Bar -->
  <header class="vm-header-bar">
    <div class="container-fluid d-flex align-items-center justify-content-between">
      <a href="/dashboard" class="vm-back-btn">
        <i class="fa-solid fa-arrow-left"></i> Back
      </a>
      <div class="vm-page-branding mx-auto">
        <h1 class="vm-main-title">Little Moments ❤️</h1>
        <p class="vm-subtitle">"Some moments are too precious to be captured in a photograph."</p>
      </div>
      <div style="width: 90px;" class="d-none d-md-block"></div> <!-- Flex spacer -->
    </div>
  </header>

  <!-- Main Container -->
  <main class="vm-container">

    <!-- Mobile-First Flow Grid -->
    <div class="vm-main-grid vm-mobile-flow">

      <!-- LEFT COLUMN (Desktop): Video Player & Meta -->
      <div class="vm-video-card vm-order-video">
        <div class="vm-player-wrapper" id="vmPlayerContainer">
          <!-- Rendered dynamically via video-memories.js -->
        </div>

        <div class="vm-video-meta-block">
          <h2 class="vm-active-title" id="vmActiveTitle">My First Giggle</h2>
          <div class="vm-badges-row">
            <span class="vm-badge" id="vmActiveDate">
              <i class="fa-solid fa-calendar-heart me-1 text-danger"></i> 15 August 2026
            </span>
            <span class="vm-badge vm-badge-age" id="vmActiveAge">
              <i class="fa-solid fa-baby me-1 text-danger"></i> 3 Months Old
            </span>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN (Desktop): Story & Quote -->
      <div class="vm-story-card vm-order-story">
        <div>
          <div class="vm-story-content" id="vmActiveStory">
            Dear Gunnu,

            Today you laughed so loudly when Daddy made that funny sound.

            Mommy couldn't stop laughing with you.

            We'll probably watch this a hundred times when you're older. ❤️
          </div>

          <div class="vm-quote-box" id="vmActiveQuoteContainer">
            <span id="vmActiveQuote">"One day you'll watch this and wonder how tiny you were."</span>
          </div>
        </div>

        <div class="vm-card-actions">
          <button class="vm-btn-icon" id="vmEditBtn" title="Edit this memory">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button class="vm-btn-icon delete" id="vmDeleteBtn" title="Delete memory">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      </div>

    </div>

    <!-- PREVIOUS / NEXT PAGINATION CONTROLS -->
    <div class="vm-pagination-bar vm-order-nav">
      <button class="vm-nav-btn" id="vmPrevBtn">
        <i class="fa-solid fa-arrow-left me-1"></i> Previous Memory
      </button>
      <span class="vm-counter-badge" id="vmCounter">1 / 4</span>
      <button class="vm-nav-btn" id="vmNextBtn">
        Next Memory <i class="fa-solid fa-arrow-right ms-1"></i>
      </button>
    </div>

    <!-- VIDEO MEMORY THUMBNAILS CAROUSEL/GRID -->
    <section class="vm-thumbnails-section vm-order-thumbs mt-4">
      <div class="vm-thumbnails-header">
        <h3 class="vm-thumbnails-title">Video Memories</h3>
      </div>
      <div class="vm-thumbnails-grid" id="vmThumbnailsGrid">
        <!-- Rendered dynamically via video-memories.js -->
      </div>
    </section>

    <!-- ADD VIDEO MEMORY BUTTON -->
    <div class="vm-add-bar vm-order-add">
      <button class="vm-add-btn" id="openAddVideoModalBtn">
        <i class="fa-solid fa-plus-circle"></i> Add Video Memory ❤️
      </button>
    </div>

  </main>

  <!-- ADD / EDIT VIDEO MEMORY MODAL -->
  <div class="modal fade vm-modal" id="addMemoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalFormTitle">Add a Video Memory ❤️</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="addMemoryForm">
          <div class="modal-body">
            
            <!-- Google Drive Video URL Input -->
            <div class="mb-3">
              <label for="vmInputVideoUrl" class="form-label">Google Drive Video URL <span class="text-danger">*</span></label>
              <input type="url" class="form-control" id="vmInputVideoUrl" placeholder="Paste Google Drive link (e.g. https://drive.google.com/file/d/.../view)" required>
              <div class="form-text text-muted small">Paste your Google Drive video link. It will automatically convert and stream!</div>
            </div>

            <!-- Live Video Modal Preview Container -->
            <div id="modalPreviewContainer" class="mb-3 d-none">
              <label class="form-label text-muted small">Video Preview:</label>
              <div class="vm-player-wrapper" id="modalPreviewPlayer" style="max-height: 240px;"></div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="vmInputTitle" class="form-label">Title <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="vmInputTitle" placeholder="My First Giggle" required>
              </div>
              <div class="col-md-3">
                <label for="vmInputDate" class="form-label">Date</label>
                <input type="text" class="form-control" id="vmInputDate" placeholder="15 August 2026">
              </div>
              <div class="col-md-3">
                <label for="vmInputAge" class="form-label">Baby Age</label>
                <input type="text" class="form-control" id="vmInputAge" placeholder="3 Months Old">
              </div>
            </div>

            <div class="mb-3">
              <label for="vmInputStory" class="form-label">Tell the story... <span class="text-danger">*</span></label>
              <textarea class="form-control" id="vmInputStory" rows="3" placeholder="Dear Gunnu, today you laughed so loudly..." required></textarea>
            </div>

            <div class="mb-3">
              <label for="vmInputQuote" class="form-label">Optional quote</label>
              <input type="text" class="form-control" id="vmInputQuote" placeholder="One day you'll watch this and wonder how tiny you were.">
            </div>
          </div>
          <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-outline-primary rounded-pill px-3" id="vmModalPreviewBtn">
              <i class="fa-solid fa-eye me-1"></i> Preview
            </button>
            <div>
              <button type="button" class="btn btn-outline-secondary rounded-pill px-3 me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn vm-save-btn">
                Save Memory <i class="fa-solid fa-heart ms-1"></i>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- PASSWORD VERIFICATION MODAL -->
  <div class="modal fade vm-modal" id="passwordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="passwordModalTitle">Enter Album Password</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center">
          <p class="text-muted mb-3">Please enter your family album password to authorize this action.</p>
          <div class="mb-3">
            <input type="password" class="form-control form-control-lg text-center" id="passwordInput" placeholder="Enter password..." autocomplete="off">
          </div>
        </div>
        <div class="modal-footer justify-content-center">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn vm-save-btn" id="confirmPasswordActionBtn">Verify & Save Memory <i class="fa-solid fa-lock ms-1"></i></button>
        </div>
      </div>
    </div>
  </div>

  <!-- Initial Hydration Data Script -->
  <script>
    window.INITIAL_VIDEO_MEMORIES = <%- JSON.stringify(videoMemories) %>;
  </script>

  <!-- Standalone Script -->
  <script src="/js/video-memories.js"></script>

<%- include('partials/footer') %>
